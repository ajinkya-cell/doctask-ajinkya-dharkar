# ==============================================================================
# SUPERDOCS DAO CONFLICT ANALYST — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE LINK (Neon PostgreSQL / Supabase / Local PostgreSQL)
# ------------------------------------------------------------------------------
# In Neon Console: Click "Connection Details" -> select "SQLAlchemy" or "AsyncPG"
# Make sure the prefix starts with "postgresql+asyncpg://"
DATABASE_URL="postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AI MODEL SETTINGS & KEYS
# ------------------------------------------------------------------------------
# Set USE_MOCK_LLM=false to activate live AI models (GPT-4o / Claude 3.5 Sonnet)
# Set USE_MOCK_LLM=true to run offline keylessly using deterministic rule engine
USE_MOCK_LLM=false

# OpenAI API Key (From https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# Anthropic API Key (From https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_API_KEY_HERE"

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="SuperDocs DAO Treasury Analyst"
DEBUG=true
WATCH_DIR="./watched"
SEED_DIR="./seed_data"
