# ==============================================================================
# HealthClaim Copilot & DAO Governance Analyst - Environment Configuration
# ==============================================================================

# NVIDIA NIM API Key (Required for live LLM extraction & classification)
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA NIM Model (Default: meta/llama-3.3-70b-instruct or meta/llama-3.1-8b-instruct)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Application Debug & DB Settings
APP_NAME=HealthClaim Copilot & DAO Governance Analyst
DEBUG=True
DATABASE_URL=sqlite+aiosqlite:///./healthclaim.db
